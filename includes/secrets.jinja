[#
  The template's secret requirements: the one place that says which credentials a generated
  repo needs and when (ADR 0003). It sits outside template/, so Copier never renders it; files
  import it with
    [% from 'includes/secrets.jinja' import secrets, store_label, condition_note with context %]
  and get `secrets`, holding only the entries that apply to this repo's answers.

  Fields:
    name        the secret's name (what `gh secret set` takes, or the env var)
    title       label for the step in docs/SETUP.md
    store       actions | local-env | secrets-manager
    used_by     repo-relative path of the file that reads it (none for the app's own keys)
    rotation    how often to rotate it
    setup       the manual step in docs/SETUP.md, one line of Markdown
    if_missing  what breaks without it (bootstrap prints this)
    waived_if   {"workflow_disabled": "<file>"}: not needed while that workflow is disabled
    only_if     "template_private": needed only when the template repo is private
  Everything but title and setup reaches .github/secret-requirements.json, which
  scripts/bootstrap-github.sh reads to apply and to check (ADR 0005).
  test-template.sh fails if the rendered workflows use an Actions secret this file doesn't list.
#]
[% set secrets = [] %]
[% if 'claude' in ai_reviewers %]
[% set _ = secrets.append({
  "name": "CLAUDE_CODE_OAUTH_TOKEN",
  "title": "Claude review",
  "store": "actions",
  "used_by": ".github/workflows/claude-review.yml",
  "rotation": "yearly (the token expires after 1 year) or on leak",
  "setup": "run `claude setup-token` and copy the token. No Claude GitHub App is needed: the workflow posts with its own `GITHUB_TOKEN`. The token often wraps onto two lines, and a copied line break breaks it (the review then fails at once with `is_error`), so check the length (about 108) and store it without whitespace: `pbpaste | tr -d '[:space:]' | wc -c`, then `pbpaste | tr -d '[:space:]' | gh secret set CLAUDE_CODE_OAUTH_TOKEN`. Copy something else afterwards to clear the clipboard.",
  "if_missing": "the Claude review job passes with a warning and reviews nothing",
}) %]
[% endif %]
[% if quality_platform == 'sonarqube-cloud' %]
[% set _ = secrets.append({
  "name": "SONARQUBE_TOKEN",
  "title": "SonarQube MCP server (local agents)",
  "store": "local-env",
  "used_by": ".mcp.json",
  "rotation": "yearly",
  "setup": "`.mcp.json` points Claude Code at SonarQube Cloud's hosted endpoint in read-only mode, so nothing runs locally. Create a **user** token (My Account → Security; project and organization tokens don't work) and export it as `SONARQUBE_TOKEN` in the shell that starts Claude Code. On macOS, run `security add-generic-password -a \"$USER\" -s SONARQUBE_TOKEN -w` once, then put `export SONARQUBE_TOKEN=\"$(security find-generic-password -a \"$USER\" -s SONARQUBE_TOKEN -w)\"` in your shell profile. Never put the value in a tracked file. Approve the `sonarqube` server when Claude Code asks, then check in `/mcp` that its tools don't include `change_sonar_issue_status` or `change_security_hotspot_status`; if they do, read-only mode isn't applied and only the deny rules in `.claude/settings.json` protect you. If the org is in the US region, the URL is `https://api.sonarqube.us/mcp`.",
  "if_missing": "the SonarQube MCP server doesn't start in local Claude Code sessions",
}) %]
[% endif %]
[% if languages %]
[% set _ = secrets.append({
  "name": "RELEASE_PLEASE_TOKEN",
  "title": "Release PRs (required)",
  "store": "actions",
  "used_by": ".github/workflows/release.yml",
  "rotation": "fine-grained PAT, ≤ 1 year",
  "setup": "create a fine-grained PAT (this repo; contents + pull requests read/write) and `gh secret set RELEASE_PLEASE_TOKEN`. Until it exists, `release.yml` fails on every push to `main`: the bootstrap stops Actions from opening PRs with the default token, and PRs that token opens wouldn't trigger CI anyway. Give it an expiry and rotate it. If this repo won't release, skip the token and run `gh workflow disable release.yml` instead.",
  "if_missing": "release.yml fails on every push to main",
  "waived_if": {"workflow_disabled": "release.yml"},
}) %]
[% endif %]
[% set _ = secrets.append({
  "name": "TEMPLATE_READ_TOKEN",
  "title": "Template updates",
  "store": "actions",
  "used_by": ".github/workflows/template-update.yml",
  "rotation": "fine-grained PAT, contents:read on the template repo, ≤ 1 year",
  "setup": "if the template repo (`_src_path` in `.copier-answers.yml`) is private, create a fine-grained PAT with contents:read on that repo only and `gh secret set TEMPLATE_READ_TOKEN`. Without it the weekly \"Template update check\" workflow fails. Give it an expiry and rotate it.",
  "if_missing": "the weekly template update check fails",
  "only_if": "template_private",
}) %]
[% if agentic %]
[% set _ = secrets.append({
  "name": "Model API keys",
  "title": "Model API keys",
  "store": "secrets-manager",
  "used_by": none,
  "rotation": "90 days",
  "setup": "one key per environment with a spend cap (Anthropic workspace / OpenAI project limits).",
  "if_missing": "the app can't call a model",
}) %]
[% set _ = secrets.append({
  "name": "EVAL_ANTHROPIC_API_KEY",
  "title": "Nightly evals",
  "store": "actions",
  "used_by": ".github/workflows/evals.yml",
  "rotation": "90 days",
  "setup": "a spend-capped key, then `gh secret set EVAL_ANTHROPIC_API_KEY`.",
  "if_missing": "the nightly evals run against the mock model only",
}) %]
[% endif %]

[% macro store_label(store) %][% if store == 'actions' %]GitHub Actions secret[% elif store == 'local-env' %]Local environment (keychain), never in the repo[% else %]Secrets manager → runtime env[% endif %][% endmacro %]

[% macro condition_note(s) %][% if s.waived_if and s.waived_if.workflow_disabled %]not needed while `[[ s.waived_if.workflow_disabled ]]` is disabled[% elif s.only_if == 'template_private' %]only if the template repo is private[% endif %][% endmacro %]
