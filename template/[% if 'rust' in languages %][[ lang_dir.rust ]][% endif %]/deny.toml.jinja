# cargo-deny: advisories (RustSec), licences, banned crates, allowed sources.
[graph]
all-features = true

[advisories]
# All RustSec advisories, including unmaintained/unsound, fail the check.
yanked = "deny"

[licenses]
allow = [
  "MIT",
  "Apache-2.0",
  "Apache-2.0 WITH LLVM-exception",
  "BSD-2-Clause",
  "BSD-3-Clause",
  "ISC",
  "Unicode-3.0",
  "Zlib",
]
confidence-threshold = 0.9
[% if not is_oss %]

# This crate's own licence. A crate with no licence fails cargo-deny as unlicensed, so the
# proprietary licence is named, and allowed for this crate only, never for a dependency.
[% raw %][[licenses.exceptions]][% endraw +%]
crate = "[[ project_slug ]]"
allow = ["LicenseRef-Proprietary"]
[% endif %]

[bans]
multiple-versions = "warn"
wildcards = "deny"

[sources]
unknown-registry = "deny"
unknown-git = "deny"
