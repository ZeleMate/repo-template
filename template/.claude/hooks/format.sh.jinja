#!/usr/bin/env bash
# PostToolUse hook: format the file Claude just edited. Never blocks (always exits 0).
set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0
file=$(jq -r '.tool_input.file_path // empty')
[ -n "$file" ] && [ -f "$file" ] || exit 0
root="${CLAUDE_PROJECT_DIR:-.}"

case "$file" in
[% if 'python' in languages %]
  *.py)
    uv run --project "$root/[[ py_dir ]]" --no-sync ruff format --quiet "$file" >/dev/null 2>&1
    uv run --project "$root/[[ py_dir ]]" --no-sync ruff check --fix --quiet "$file" >/dev/null 2>&1
    ;;
[% endif %]
[% if 'typescript' in languages %]
  *.ts|*.tsx|*.js|*.mjs|*.cjs|*.json|*.css)
    pnpm --dir "$root/[[ ts_dir ]]" exec prettier --write --log-level silent "$file" >/dev/null 2>&1
    ;;
[% endif %]
[% if 'rust' in languages %]
  *.rs)
    rustfmt --edition 2024 "$file" >/dev/null 2>&1
    ;;
[% endif %]
esac
exit 0
