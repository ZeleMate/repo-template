version: 2
updates:
  # Copier for template-update.yml (.github/tools/uv.lock), locked apart from the app.
  - package-ecosystem: uv
    directory: /.github/tools
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
    groups:
      ci-tools:
        patterns: ["*"]
    commit-message:
      prefix: ci

  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    # Third-party actions wait 7 days. The central workflows are our own, so they don't.
    cooldown:
      default-days: 7
      exclude: ["ZeleMate/workflows*"]
    groups:
      # Apart from `actions`, so a red central bump doesn't block unrelated updates.
      central-workflows:
        patterns: ["ZeleMate/workflows*"]
      actions:
        patterns: ["*"]
        exclude-patterns: ["ZeleMate/workflows*"]
    ignore:
      # A major central release needs caller edits, so it arrives with a template update.
      - dependency-name: "ZeleMate/workflows*"
        update-types: ["version-update:semver-major"]
    commit-message:
      prefix: ci
[% from 'includes/languages.jinja' import managed with context %]
[% for l in managed.values() %]

[% if l.id == 'go' %]
  # Never raises go.mod's go line: the floor moves only with `copier update -d go_version=1.N`.
[% endif %]
  - package-ecosystem: [[ l.dependabot.ecosystem ]]
    directory: /[[ '' if l.dir == '.' else l.dir ]]
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
      semver-major-days: 14
    groups:
      [[ l.dependabot.group ]]:
        update-types: [minor, patch]
    commit-message:
      prefix: deps
[% endfor %]
[% set managed_root = [] %]
[% if not multi_lang %]
[% for l in managed.values() %][% set _ = managed_root.append(l.dependabot.ecosystem) %][% endfor %]
[% endif %]
[% for eco in extra_ecosystems if eco not in managed_root %]

  # Named in the `extra_ecosystems` answer: this repo's own stack, not a managed language.
  - package-ecosystem: [[ eco ]]
    directory: /
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
[% if eco != 'docker' %]
      semver-major-days: 14
[% endif %]
    groups:
      [[ eco ]]-minor-patch:
        update-types: [minor, patch]
    commit-message:
      prefix: deps
[% endfor %]
