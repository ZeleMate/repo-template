[% macro out(dir, field) %][[ field if dir == '.' else dir ~ '--' ~ field ]][% endmacro %]
name: Release

# release-please keeps a release PR open from Conventional Commit titles; merging it tags and releases.
# It needs a RELEASE_PLEASE_TOKEN secret (fine-grained PAT on this repo: contents + pull requests
# read/write). GITHUB_TOKEN can't do it: the bootstrap stops Actions from opening PRs, and PRs it
# opens wouldn't trigger CI, so the release PR's ci-ok check would never run.
#
# Releases are created as drafts (with their tag) and published by the sbom job once the SBOM
# is attached: an immutable release can't take assets after it is published.
on:
  push:
    branches: [main]

permissions: {}

concurrency:
  group: release
  cancel-in-progress: false

jobs:
  release-please:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
      pull-requests: write
      issues: write
    outputs:
      any: ${{ steps.rp.outputs.releases_created }}
[% for l in languages %]
[% set d = {'python': py_dir, 'typescript': ts_dir, 'rust': rs_dir, 'go': go_dir}[l] %]
      [[ l ]]: ${{ steps.rp.outputs['[[ out(d, 'release_created') ]]'] }}
      [[ l ]]_tag: ${{ steps.rp.outputs['[[ out(d, 'tag_name') ]]'] }}
[% endfor %]
    steps:
      - name: Require RELEASE_PLEASE_TOKEN
        env:
          TOKEN: ${{ secrets.RELEASE_PLEASE_TOKEN }}
        run: |
          if [ -z "$TOKEN" ]; then
            echo "::error title=RELEASE_PLEASE_TOKEN missing::No release PR without it. Create a fine-grained PAT for this repo (contents + pull requests read/write) and run: gh secret set RELEASE_PLEASE_TOKEN"
            exit 1
          fi
      - uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7  # v5.0.0
        id: rp
        with:
          token: ${{ secrets.RELEASE_PLEASE_TOKEN }}
          config-file: release-please-config.json
          manifest-file: .release-please-manifest.json
[% if publishes %]
[% if 'python' in languages %]

  publish-python:
    needs: release-please
    if: needs.release-please.outputs.python == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
[% if has_governance %]
    environment: release
[% endif %]
    permissions:
      contents: read
      id-token: write
[% if is_public %]
      attestations: write
[% endif %]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2  # v10.3.3
        with:
          enable-cache: false
      - run: uv build
        working-directory: [[ py_dir ]]
[% if is_public %]
      - uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8  # v4.2.2
        with:
          subject-path: "[[ py_dir ]]/dist/*"
[% endif %]
      # Trusted publishing (OIDC): register this repo + workflow as a trusted publisher on PyPI first.
      # Produces PEP 740 attestations by default.
      - uses: pypa/gh-action-pypi-publish@7245906fb61fa33a13554f9d5fb856fe61758086  # v1.14.3
        with:
          packages-dir: [[ py_dir ]]/dist/
[% endif %]
[% if 'typescript' in languages %]

  publish-npm:
    needs: release-please
    if: needs.release-please.outputs.typescript == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
[% if has_governance %]
    environment: release
[% endif %]
    permissions:
      contents: read
      id-token: write
    defaults:
      run:
        working-directory: [[ ts_dir ]]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413  # v6.1.0
        with:
          package_json_file: [[ ts_dir ]]/package.json
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1  # v7.1.0
        with:
          node-version: "[[ node_version ]]"
          registry-url: https://registry.npmjs.org
      - run: pnpm install --frozen-lockfile
      - run: pnpm run build
      # Trusted publishing (OIDC): configure this repo + workflow as a trusted publisher on npmjs.com first.
      - run: npm publish --access public
[% if not is_public %]
        env:
          NPM_CONFIG_PROVENANCE: "false"  # npm provenance is not supported from private repos
[% endif %]
[% endif %]
[% if 'rust' in languages %]

  publish-crate:
    needs: release-please
    if: needs.release-please.outputs.rust == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 20
[% if has_governance %]
    environment: release
[% endif %]
    permissions:
      contents: read
      id-token: write
    defaults:
      run:
        working-directory: [[ rs_dir ]]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - run: rustup show active-toolchain || rustup toolchain install
      # Trusted publishing (OIDC): configure the crate's trusted publisher on crates.io first.
      - uses: rust-lang/crates-io-auth-action@3268eb413133e2960fa4ae0e963ca76380c54cd9  # v1.0.6
        id: auth
      - run: cargo publish --locked
        env:
          CARGO_REGISTRY_TOKEN: ${{ steps.auth.outputs.token }}
[% endif %]
[% if 'go' in languages %]
[% from 'includes/go.jinja' import go_newest %]

  # Go has no registry: the tag is the release, and proxy.golang.org fetches it on first use.
  # This job adds cross-compiled binaries and SHA256SUMS to the draft release.
  publish-go:
    needs: release-please
    if: needs.release-please.outputs.go == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
[% if has_governance %]
    environment: release
[% endif %]
    permissions:
      contents: write  # gh release upload into the draft
[% if is_public %]
      id-token: write
      attestations: write
[% endif %]
    defaults:
      run:
        working-directory: [[ go_dir ]]
    env:
      TAG: ${{ needs.release-please.outputs.go_tag }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      # The newest Go CI tests, at its latest patch, so the binaries carry a current standard library.
      - uses: actions/setup-go@d8cbb8045d7f43706b9177cceb36c1f91a6644d5  # v7.1.0
        with:
          go-version: "1.[[ go_newest ]]"
          check-latest: true
          cache: false
      - name: Build the binaries and SHA256SUMS
        env:
          CGO_ENABLED: "0"
        run: |
          version="${TAG##*/}"  # go/v1.2.3 -> v1.2.3
          mkdir -p dist
          for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64 windows/arm64; do
            os="${target%/*}"; arch="${target#*/}"; ext=""
            [ "$os" = windows ] && ext=.exe
            GOOS="$os" GOARCH="$arch" go build -trimpath -ldflags "-s -w -X main.version=$version" \
              -o "dist/[[ project_slug ]]_${os}_${arch}${ext}" ./cmd/[[ project_slug ]]
          done
          (cd dist && sha256sum -- [[ project_slug ]]_* > SHA256SUMS)
[% if is_public %]
      - uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6  # v4.2.2
        with:
          subject-checksums: [[ go_dir ]]/dist/SHA256SUMS
[% endif %]
      - name: Upload to the draft release
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release upload "$TAG" dist/* --clobber --repo "$GITHUB_REPOSITORY"
[% if is_public %]
      # Optional: the proxy would fetch the version on first use anyway. Never in a private repo,
      # where the proxy can't fetch it and the request would leak the module path.
      - name: Warm the Go module proxy
        env:
          GOPROXY: https://proxy.golang.org
          MODULE: [[ go_module ]]
        working-directory: ${{ runner.temp }}
        run: go list -m "$MODULE@${TAG##*/}" || echo "::warning::proxy.golang.org could not fetch $MODULE@${TAG##*/} yet"
[% endif %]
[% endif %]
[% endif %]

  sbom:
[% if publishes and 'go' in languages %]
    # Waits for the Go binaries, so a failed Go build leaves the release a draft.
    needs: [release-please, publish-go]
    if: ${{ !cancelled() && needs.release-please.outputs.any == 'true' && needs.publish-go.result != 'failure' }}
[% else %]
    needs: release-please
    if: needs.release-please.outputs.any == 'true'
[% endif %]
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: anchore/sbom-action@66cbf4bc1f1c0d2edc94016e65bc221b6bb0ad6c  # v0.24.3
        with:
          path: .
          format: spdx-json
          output-file: sbom.spdx.json
          upload-artifact: false
          upload-release-assets: false
      - name: Attach the SBOM, then publish the draft release(s)
        env:
          GH_TOKEN: ${{ github.token }}
          TAGS: >-
[% for l in languages %]
            ${{ needs.release-please.outputs.[[ l ]]_tag }}
[% endfor %]
        run: |
          for tag in $TAGS; do
            gh release upload "$tag" sbom.spdx.json --clobber --repo "$GITHUB_REPOSITORY"
            gh release edit "$tag" --draft=false --repo "$GITHUB_REPOSITORY"
          done
