name: Security

# Weekly, so new advisories against unchanged code are caught. ci.yml calls the same
# reusable workflow on every PR and push, where it feeds the merge gate.
on:
  workflow_dispatch:
  schedule:
    - cron: "23 5 * * 1"

permissions: {}

jobs:
  security:
    uses: ZeleMate/workflows/.github/workflows/security.yml@602f4864a39078a3abf28485cf9a69c73ef77418  # v1.0.0
    permissions:
      contents: read
    with:
      # Semgrep runs on private repos; public repos use CodeQL default setup instead.
      sast: [[ 'false' if is_public else 'true' ]]
