name: CI

on:
  pull_request:
  push:
    branches: [main]

permissions: {}

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  repo-lint:
    name: repo-lint
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2  # v10.3.3
      - uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9  # v6.1.0
        with:
          path: ~/.cache/pre-commit
          key: pre-commit-${{ runner.os }}-${{ hashFiles('.pre-commit-config.yaml') }}
      # Language-toolchain hooks run in the language jobs; gitleaks scans full history in security.yml.
      - run: uvx pre-commit@4.7.0 run --all-files --show-diff-on-failure
        env:
          SKIP: gitleaks,prettier,cargo-fmt
[% if 'python' in languages %]

  python:
    name: python
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    defaults:
      run:
        working-directory: [[ py_dir ]]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2  # v10.3.3
        with:
          enable-cache: true
          cache-dependency-glob: "[[ py_dir ]]/uv.lock"
      - run: uv sync --locked
      - run: uv run ruff format --check .
      - run: uv run ruff check .
[% if python_type_checker == 'pyright' %]
      - run: uv run pyright
[% else %]
      - run: uv run mypy
[% endif %]
      - run: uv run pytest --cov --cov-report=xml --cov-report=term
      - name: Changed-line coverage ≥ 90%
        if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ github.base_ref }}
        run: uv run diff-cover coverage.xml --compare-branch="origin/${BASE_REF}" --fail-under=90
[% if quality_platform == 'sonarqube-cloud' %]
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9  # v7.0.2
        with:
          name: coverage-python
          path: [[ py_dir ]]/coverage.xml
          retention-days: 1
[% endif %]
[% endif %]
[% if 'typescript' in languages %]

  typescript:
    name: typescript
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    defaults:
      run:
        working-directory: [[ ts_dir ]]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413  # v6.1.0
        with:
          package_json_file: [[ ts_dir ]]/package.json
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1  # v7.1.0
        with:
          node-version: "[[ node_version ]]"
          cache: pnpm
          cache-dependency-path: [[ ts_dir ]]/pnpm-lock.yaml
      - run: pnpm install --frozen-lockfile
      - run: pnpm run format:check
      - run: pnpm run lint
      - run: pnpm run typecheck
      - run: pnpm run test:coverage
      - name: Changed-line coverage ≥ 90%
        if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ github.base_ref }}
        run: uvx diff-cover@11.0.0coverage/cobertura-coverage.xml --compare-branch="origin/${BASE_REF}" --fail-under=90
      - run: pnpm run build
[% if quality_platform == 'sonarqube-cloud' %]
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9  # v7.0.2
        with:
          name: coverage-typescript
          path: [[ ts_dir ]]/coverage/lcov.info
          retention-days: 1
[% endif %]
[% endif %]
[% if 'rust' in languages %]

  rust:
    name: rust
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
    defaults:
      run:
        working-directory: [[ rs_dir ]]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - run: rustup show active-toolchain || rustup toolchain install  # installs the rust-toolchain.toml pin
      - uses: taiki-e/install-action@68a389c788b2cd04016ce8c80ee23b80d2ab3d68  # v2.88.1
        with:
          tool: cargo-nextest,cargo-deny
      - run: cargo fmt --check
      - run: cargo clippy --all-targets --locked -- -D warnings
      - run: cargo nextest run --locked
      - run: cargo test --doc --locked
      - run: cargo deny check
[% endif %]

  security:
    name: security
    uses: $/.github/workflows/security.yml
    permissions:
      contents: read
[% if quality_platform == 'sonarqube-cloud' %]

  sonarqube:
    name: sonarqube
    # Fork PRs get no secrets, so they cannot be analysed.
    if: github.event_name == 'push' || github.event.pull_request.head.repo.full_name == github.repository
[% set covered = languages | reject('equalto', 'rust') | list %]
[% if covered %]
    needs: [[ '[' ]][[ covered | join(', ') ]][[ ']' ]]
[% endif %]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0
[% if 'python' in languages %]
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333  # v8.0.2
        with:
          name: coverage-python
          path: [[ py_dir ]]
[% endif %]
[% if 'typescript' in languages %]
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333  # v8.0.2
        with:
          name: coverage-typescript
          path: [[ ts_dir ]]/coverage
[% endif %]
      - uses: SonarSource/sonarqube-scan-action@4d1dc0c91ee400dcf8a6dddf2f705ac36542e304  # v8.4.0
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
[% endif %]

  # Single required status check for the ruleset. Fails if any job failed or was cancelled.
  ci-ok:
    name: ci-ok
    if: always()
    needs:
      - repo-lint
[% for l in languages %]
      - [[ l ]]
[% endfor %]
      - security
[% if quality_platform == 'sonarqube-cloud' %]
      - sonarqube
[% endif %]
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions: {}
    steps:
      - env:
          RESULTS: ${{ join(needs.*.result, ' ') }}
        run: |
          echo "results: $RESULTS"
          case "$RESULTS" in *failure*|*cancelled*) exit 1 ;; esac
