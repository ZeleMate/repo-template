name: CI

# Caller workflow: each job below calls a reusable workflow in ZeleMate/workflows, all pinned
# to the same release SHA. Dependabot moves the pin through minor and patch releases; a major
# arrives with a template update. This file is the template's: put jobs of your own in
# ci-local.yml, which the `local` job below calls and the merge gate waits on.
on:
  pull_request:
  push:
    branches: [main]

permissions: {}

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  repo-lint:
    uses: ZeleMate/workflows/.github/workflows/repo-lint.yml@1908ed9c83fa76ed4361d2cccff80ae401503fc5  # v1.1.0
    permissions:
      contents: read
[% if 'python' in languages %]

[% set py_lo = python_version.split('.')[1] | int %]
[% set py_hi = (python_max_version.split('.')[1] | int) if python_max_version else ([py_lo, 14] | max) %]
  python:
    uses: ZeleMate/workflows/.github/workflows/python.yml@1908ed9c83fa76ed4361d2cccff80ae401503fc5  # v1.1.0
    permissions:
      contents: read
    with:
      # Every supported minor version: python_version up to python_max_version (or the newest).
      python-versions: '[[ '[' ]][% for m in range(py_lo, py_hi + 1) %]"3.[[ m ]]"[% if not loop.last %], [% endif %][% endfor %][[ ']' ]]'
      type-checker: [[ python_type_checker ]]
      working-directory: [[ py_dir ]]
[% endif %]
[% if 'typescript' in languages %]

  typescript:
    uses: ZeleMate/workflows/.github/workflows/typescript.yml@1908ed9c83fa76ed4361d2cccff80ae401503fc5  # v1.1.0
    permissions:
      contents: read
    with:
      node-version: "[[ node_version ]]"
      working-directory: [[ ts_dir ]]
[% endif %]
[% if 'rust' in languages %]

  rust:
    uses: ZeleMate/workflows/.github/workflows/rust.yml@1908ed9c83fa76ed4361d2cccff80ae401503fc5  # v1.1.0
    permissions:
      contents: read
    with:
      working-directory: [[ rs_dir ]]
[% endif %]
[% if 'go' in languages %]

[% from 'includes/go.jinja' import go_newest %]
[% set go_lo = go_version.split('.')[1] | int %]
[% set go_hi = [go_lo, go_newest] | max %]
  go:
    uses: ZeleMate/workflows/.github/workflows/go.yml@1908ed9c83fa76ed4361d2cccff80ae401503fc5  # v1.1.0
    permissions:
      contents: read
    with:
      # Every minor from go_version (go.mod's floor) up to the newest the template knows.
      # Move the floor with `copier update -d go_version=1.N`, never by editing go.mod alone.
      go-versions: '[[ '[' ]][% for m in range(go_lo, go_hi + 1) %]"1.[[ m ]]"[% if not loop.last %], [% endif %][% endfor %][[ ']' ]]'
      working-directory: [[ go_dir ]]
[% endif %]

  security:
    uses: ZeleMate/workflows/.github/workflows/security.yml@1908ed9c83fa76ed4361d2cccff80ae401503fc5  # v1.1.0
    permissions:
      contents: read
    with:
      # Semgrep runs on private repos; public repos use CodeQL default setup instead.
      sast: [[ 'false' if is_public else 'true' ]]

  # This repo's own jobs. ci-local.yml is written once by the template and never updated.
  # `$/` is GitHub's self-repository syntax, not a typo for `./` (zizmor's self-repository audit).
  local:
    uses: $/.github/workflows/ci-local.yml
    permissions:
      contents: read

  # The merge gate: the single required status check for the ruleset.
  # Fails if any job failed or was cancelled. repo-lint checks that every job is listed here.
  ci-ok:
    name: ci-ok
    if: always()
    needs:
      - repo-lint
[% for l in languages %]
      - [[ l ]]
[% endfor %]
      - security
      - local
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions: {}
    steps:
      - env:
          RESULTS: ${{ join(needs.*.result, ' ') }}
        run: |
          echo "results: $RESULTS"
          case "$RESULTS" in *failure*|*cancelled*) exit 1 ;; esac
