name: CI

# Caller workflow: each job below calls a reusable workflow in ZeleMate/workflows, all pinned
# to the same release SHA. Dependabot moves the pin through minor and patch releases; a major
# arrives with a template update. A job of your own goes here too: add it to ci-ok's needs.
on:
  pull_request:
  push:
    branches: [main]

permissions: {}

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  repo-lint:
    uses: ZeleMate/workflows/.github/workflows/repo-lint.yml@95244ca1c8b62ab0f3d56aefee2c60348445d132  # v1.0.0
    permissions:
      contents: read
[% if 'python' in languages %]

[% set py_lo = python_version.split('.')[1] | int %]
  python:
    uses: ZeleMate/workflows/.github/workflows/python.yml@95244ca1c8b62ab0f3d56aefee2c60348445d132  # v1.0.0
    permissions:
      contents: read
    with:
      # Every supported minor version, from requires-python up.
      python-versions: '[[ '[' ]][% for m in range(py_lo, [py_lo, 14] | max + 1) %]"3.[[ m ]]"[% if not loop.last %], [% endif %][% endfor %][[ ']' ]]'
      type-checker: [[ python_type_checker ]]
      working-directory: [[ py_dir ]]
[% endif %]
[% if 'typescript' in languages %]

  typescript:
    uses: ZeleMate/workflows/.github/workflows/typescript.yml@95244ca1c8b62ab0f3d56aefee2c60348445d132  # v1.0.0
    permissions:
      contents: read
    with:
      node-version: "[[ node_version ]]"
      working-directory: [[ ts_dir ]]
[% endif %]
[% if 'rust' in languages %]

  rust:
    uses: ZeleMate/workflows/.github/workflows/rust.yml@95244ca1c8b62ab0f3d56aefee2c60348445d132  # v1.0.0
    permissions:
      contents: read
    with:
      working-directory: [[ rs_dir ]]
[% endif %]

  security:
    uses: ZeleMate/workflows/.github/workflows/security.yml@95244ca1c8b62ab0f3d56aefee2c60348445d132  # v1.0.0
    permissions:
      contents: read
    with:
      # Semgrep runs on private repos; public repos use CodeQL default setup instead.
      sast: [[ 'false' if is_public else 'true' ]]

  # The merge gate: the single required status check for the ruleset.
  # Fails if any job failed or was cancelled. repo-lint checks that every job is listed here.
  ci-ok:
    name: ci-ok
    if: always()
    needs:
      - repo-lint
[% for l in languages %]
      - [[ l ]]
[% endfor %]
      - security
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions: {}
    steps:
      - env:
          RESULTS: ${{ join(needs.*.result, ' ') }}
        run: |
          echo "results: $RESULTS"
          case "$RESULTS" in *failure*|*cancelled*) exit 1 ;; esac
