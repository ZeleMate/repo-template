[% from 'includes/secrets.jinja' import secrets with context %]
[% set out = [] %]
[% for s in secrets %]
[% set entry = {"name": s.name, "store": s.store, "used_by": s.used_by, "rotation": s.rotation, "if_missing": s.if_missing} %]
[% if s.waived_if %][% set _ = entry.update({"waived_if": s.waived_if}) %][% endif %]
[% if s.only_if %][% set _ = entry.update({"only_if": s.only_if}) %][% endif %]
[% set _ = out.append(entry) %]
[% endfor %]
[[ {"_comment": "Written by the repo template from includes/secrets.jinja (ADR 0003); refreshed by copier update. Names and rules only, never values.", "secrets": out} | tojson(indent=2) ]]
