[% from 'includes/languages.jinja' import managed with context %]
[% set out = [] %]
[% for id in languages %]
[% set l = managed[id] %]
[% set checks = [] %]
[% for c in l.checks %]
[% set check = {"name": c.name, "run": c.run} %]
[% if c.tool %][% set _ = check.update({"tool": c.tool}) %][% endif %]
[% set _ = checks.append(check) %]
[% endfor %]
[% set _ = out.append({"id": id, "name": l.name, "dir": l.dir, "toolchain": l.toolchain, "lock": l.lock, "checks": checks}) %]
[% endfor %]
